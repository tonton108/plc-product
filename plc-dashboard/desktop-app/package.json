{
  "name": "plc-monitoring-desktop",
  "version": "1.0.0",
  "description": "PLC Monitoring Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "prepare:postgres": "node scripts/prepare-postgres.cjs",
    "electron:build": "npm run prepare:postgres && npm run build && electron-builder",
    "electron:build:win": "npm run prepare:postgres && npm run build && electron-builder --win"
  },
  "keywords": ["electron", "vue", "plc", "monitoring"],
  "author": "Your Company",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.5.0",
    "@mdi/font": "^7.4.0",
    "chart.js": "^4.4.0",
    "socket.io-client": "^4.6.0",
    "axios": "^1.6.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "electron": "^25.9.8",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yourcompany.plc-monitoring",
    "productName": "PLC Monitoring",
    "afterPack": "./scripts/afterPack.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../backend/postgres-portable/**/*",
      "../backend/**/*.py",
      "../backend/requirements.txt",
      "../backend/.env.example",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/postgres-portable",
        "to": "backend/postgres-portable",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*.py", "requirements.txt", ".env.example"]
      },
      {
        "from": "nuxt-dist",
        "to": "nuxt-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
