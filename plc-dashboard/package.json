{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:electron": "nuxt generate && node scripts/copy-to-electron.js",
    "electron:dev": "cd electron && npm start",
    "electron:install": "cd electron && npm install",
    "electron:build": "npm run build:electron && cd electron && npm run build"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/i18n": "^9.5.6",
    "chart.js": "^4.5.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "hammerjs": "^2.0.8",
    "nuxt": "^3.17.6",
    "sass": "^1.89.2",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "vuetify": "^3.9.0"
  }
}
