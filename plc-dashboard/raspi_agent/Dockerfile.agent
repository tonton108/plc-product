FROM python:3.10-slim

WORKDIR /app

# システムパッケージのインストール
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Python依存関係のインストール
COPY requirements_agent.txt ./
RUN pip install --no-cache-dir -r requirements_agent.txt

# アプリケーションコードをコピー
COPY . /app

# バックエンドコードへのアクセスを設定
ENV PYTHONPATH=/app

# ポート公開
EXPOSE 5001

# エージェントアプリケーション起動
CMD ["python", "agent_app.py"]
