# PostgreSQLデータベース設定
POSTGRES_USER=plc_user
POSTGRES_PASSWORD=plc_pass
POSTGRES_DB=plc_monitor
POSTGRES_PORT=5432

# Flask設定
FLASK_ENV=development
SECRET_KEY=your-secure-secret-key-change-in-production

# CORS設定（イントラネット環境）
# 開発環境（localhost）:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 本番環境（不特定多数のPC・スマホからアクセス）:
# イントラネット全体を許可（工場内LANのみなのでセキュリティ上問題なし）
# CORS_ORIGINS=*
# または中央サーバーのIPを明示的に指定:
# CORS_ORIGINS=http://192.168.1.10:3000

# 中央サーバーAPI設定
# 開発環境:
CENTRAL_SERVER_IP=localhost
CENTRAL_SERVER_PORT=5000
# 本番環境（中央サーバーのIPが192.168.1.10の場合）:
# CENTRAL_SERVER_IP=192.168.1.10

# Nuxt UI公開用API設定（クライアント端末がアクセスするURL）
# 開発環境:
NUXT_PUBLIC_API_BASE=http://localhost:5000
# 本番環境（不特定多数の端末がアクセス）:
# NUXT_PUBLIC_API_BASE=http://192.168.1.10:5000

# Raspberry Piエージェント設定
RASPI_UI_PORT=5001
USE_DUMMY_PLC=true

# PLC接続設定
PLC_IP=192.168.1.100
PLC_PORT=5000
PLC_MANUFACTURER=Mitsubishi
LOG_INTERVAL_MS=5000

# セキュリティ設定
REQUIRE_AUTH=true
ADMIN_USERNAME=admin
# デフォルトパスワード: admin123
ADMIN_PASSWORD_HASH=e2c6ed4d94bc3d1b605cb5fe7e92e48546b26e0f1e30f97e8151af9f9abb0844

# エラー処理設定
MAX_RETRY_ATTEMPTS=3
CONNECTION_TIMEOUT=5
READ_TIMEOUT=3

# データベースURL（自動生成される場合は不要）
DATABASE_URL=postgresql+psycopg2://plc_user:plc_pass@localhost:5432/plc_monitor

# MCP Server設定（Claude Code用）
# GitHub Personal Access Token
# 取得方法: https://github.com/settings/tokens
# 必要なスコープ: repo, read:org, read:user
GITHUB_TOKEN=your_github_personal_access_token_here
