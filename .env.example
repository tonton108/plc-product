# ========================================
# PLC監視システム - 環境変数設定（テンプレート）
# ========================================
#
# 使い方:
# 1. このファイルを .env にコピーしてください
#    cp .env.example .env
#
# 2. 各値を実際の環境に合わせて変更してください
#
# 3. 本番環境では必ず強固なパスワードとランダムなシークレットキーを設定してください
#
# ========================================

# ----------------------------------------
# PostgreSQLデータベース設定
# ----------------------------------------
POSTGRES_USER=plc_user
# ⚠️ 本番環境では強固なパスワードに変更してください
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=plc_monitor
POSTGRES_PORT=5433

# ----------------------------------------
# Flask設定
# ----------------------------------------
FLASK_ENV=development
FLASK_APP=manage.py

# ⚠️ 本番環境では必ず変更してください！
# ランダムな文字列を生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# ----------------------------------------
# Node.js / Nuxt.js設定
# ----------------------------------------
NODE_ENV=development
NUXT_PUBLIC_API_BASE=http://localhost:5000

# ----------------------------------------
# 中央サーバーAPI設定
# ----------------------------------------
CENTRAL_SERVER_IP=backend
CENTRAL_SERVER_PORT=5000

# ----------------------------------------
# Raspberry Piエージェント設定
# ----------------------------------------
RASPI_UI_PORT=5001
USE_DUMMY_PLC=true

# ----------------------------------------
# PLC接続設定
# ----------------------------------------
PLC_IP=192.168.1.100
PLC_PORT=5000
PLC_MANUFACTURER=Mitsubishi
LOG_INTERVAL_MS=5000

# ----------------------------------------
# エラー処理設定
# ----------------------------------------
MAX_RETRY_ATTEMPTS=3
CONNECTION_TIMEOUT=5
READ_TIMEOUT=3

# ----------------------------------------
# セキュリティ設定
# ----------------------------------------
REQUIRE_AUTH=true
ADMIN_USERNAME=admin

# ⚠️ 本番環境では必ず変更してください！
# パスワードのハッシュを生成:
#   python -c "import hashlib; password='YOUR_PASSWORD'; print(hashlib.sha256(password.encode()).hexdigest())"
#
# デフォルト: admin123
ADMIN_PASSWORD_HASH=CHANGE_ME_AFTER_RUNNING_HASH_SCRIPT

# ----------------------------------------
# CORS設定
# ----------------------------------------
# カンマ区切りで複数のオリジンを指定可能
# 開発環境
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 本番環境の例
# CORS_ORIGINS=https://plc-monitor.example.com,https://dashboard.example.com

# ----------------------------------------
# ログ設定
# ----------------------------------------
# ログレベル: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------
# データベースURL（通常は自動生成されるため設定不要）
# ----------------------------------------
# DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
