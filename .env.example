# ========================================
# PLC監視システム - 環境変数設定
# ========================================
#
# 📌 重要: この統合プロジェクトの環境変数設定は
#         plc-dashboard/.env.example を使用してください
#
# このファイルは Docker Compose 用のルートレベル設定です。
# ローカル開発環境では以下のファイルを使用してください:
#
#   plc-dashboard/.env.example
#
# ========================================

# ----------------------------------------
# Docker Compose用設定
# ----------------------------------------
POSTGRES_USER=plc_user
POSTGRES_PASSWORD=plc_pass
POSTGRES_DB=plc_monitor
POSTGRES_PORT=5432

# Docker内部のサービス名
CENTRAL_SERVER_IP=backend
CENTRAL_SERVER_PORT=5000
